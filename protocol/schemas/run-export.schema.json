                      "minLength": 1,
                      "maxLength": 200
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "human",
                        "bot"
                      ]
                    },
                    "policy": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "policy"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "seed",
              "participants"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "createdAt",
        "kind",
        "game",
        "configuration",
        "trials"
