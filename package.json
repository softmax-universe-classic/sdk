{
  "name": "softmax-universe-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "contracts:check": "node scripts/check-contracts.mjs",
    "architecture:setup": "npm --prefix .contracts/008-code-dependency-boundaries/assets/npm ci --ignore-scripts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "check": "pnpm contracts:check && pnpm format:check && pnpm build && pnpm lint && pnpm architecture:check && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@types/node": "24.13.6",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.33.2"
}
