{
  "name": "@softmax-universe/model-policy",
  "version": "0.3.0-alpha.2",
  "description": "Choose legal game actions through Foundation Models.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "type-check": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@softmax-foundation/models": "https://github.com/Metta-AI/foundation-models/releases/download/models-v0.1.2/softmax-foundation-models-0.1.2.tgz",
    "@softmax-universe/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
