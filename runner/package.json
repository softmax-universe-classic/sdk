{
  "name": "@softmax-universe/runner",
  "version": "0.3.0-alpha.4",
  "description": "Run bounded local game benchmarks and upload saved Universe recordings.",
  "license": "MIT",
  "bin": {
    "universe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test --test-timeout=15000 test/*.test.ts"
  },
  "dependencies": {
    "@softmax-universe/protocol": "workspace:*",
    "@softmax-universe/sdk": "workspace:^"
  },
  "devDependencies": {
    "@softmax-universe/model-policy": "workspace:*",
    "@types/node": "24.13.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
