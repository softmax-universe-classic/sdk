                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                    },
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "kind",
