{
  "name": "@softmax-universe/sdk",
  "version": "0.2.0-alpha.1",
  "description": "Record and exchange observable game episodes with Softmax Universe.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/run.schema.json": "./schemas/run.schema.json",
    "./schemas/episode.schema.json": "./schemas/episode.schema.json",
    "./schemas/run-export.schema.json": "./schemas/run-export.schema.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/export-schemas.mjs",
    "prepack": "pnpm run build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
