                      "format": "uri"
                    },
                    "workspaceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "mechId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "turnId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "release": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "kind",
                    "origin",
                    "workspaceId",
                    "mechId",
                    "requestId",
                    "turnId"
