                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "completed",
                          "failed",
                          "unknown"
                        ]
                      },
                      "error": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
