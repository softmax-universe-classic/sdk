                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
