            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "participants": {
                "minItems": 1,
                "maxItems": 32,
