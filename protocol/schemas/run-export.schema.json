                },
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "rejected",
                    "error",
                    "pending"
                  ]
                },
                "modelCalls": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
