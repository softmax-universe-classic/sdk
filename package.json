{
  "name": "softmax-universe-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "pnpm build && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
