                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "human",
                    "bot"
                  ]
                },
                "policy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "model": {
