{
  "name": "@softmax-universe/mechane",
  "version": "0.3.0-alpha.3",
  "description": "Use bounded Mechane agent turns as Universe game policies.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test --test-timeout=15000 test/*.test.ts"
  },
  "dependencies": {
    "@mechane/client": "https://github.com/mechane-ai/mechane/releases/download/client-v0.1.0/mechane-client-0.1.0.tgz",
    "@softmax-universe/protocol": "workspace:*",
    "effect": "4.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@softmax-universe/runner": "workspace:*",
    "@types/node": "24.13.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
